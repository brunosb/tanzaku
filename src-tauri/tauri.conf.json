{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Tanzaku",
    "version": "1.0.1",
    "identifier": "com.tanzaku.desktop.experiment",
    "build": {
        "frontendDist": "../dist",
        "beforeBuildCommand": "npm run build:ui"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Tanzaku",
                "width": 900,
                "height": 920,
                "resizable": true,
                "decorations": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
        },
        "withGlobalTauri": true
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "template": "nsis/installer.nsi",
                "installMode": "currentUser",
                "installerIcon": "icons/icon.ico",
                "uninstallerIcon": "icons/icon.ico"
            },
            "webviewInstallMode": {
                "type": "embedBootstrapper"
            }
        },
        "resources": [
            "models/nmp.onnx",
            "runtime/onnxruntime.dll",
            "bin/yt-dlp.exe",
            "bin/ffmpeg.exe",
            "licenses/**/*",
            "bin/qjs.exe",
            "runtime/distribution.json",
            "msvcp140.dll",
            "bin/msvcp140.dll",
            "msvcp140_1.dll",
            "bin/msvcp140_1.dll",
            "vcruntime140.dll",
            "bin/vcruntime140.dll",
            "vcruntime140_1.dll",
            "bin/vcruntime140_1.dll"
        ]
    }
}
