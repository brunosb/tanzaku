{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Tanzaku Tauri Experiment",
    "version": "0.1.0",
    "identifier": "com.tanzaku.desktop.experiment",
    "build": {
        "frontendDist": "../dist-tauri"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Tanzaku Tauri Experiment",
                "width": 900,
                "height": 600,
                "resizable": true,
                "decorations": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'"
        },
        "withGlobalTauri": true
    },
    "bundle": {
        "active": false,
        "icon": []
    }
}
