{
    "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "asNeeded"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "none"
        }
    },
    "files": {
        "includes": [
            "**",
            "!node_modules/**",
            "!.venv/**",
            "!dist/**",
            "!src-tauri/target/**",
            "!src-tauri/gen/**",
            "!midi-cache/**/*.mid",
            "!midi-cache/.plan-cache/**"
        ]
    }
}
