{
    "name": "tanzaku",
    "version": "1.0.0",
    "description": "Toca MIDI no modo de música livre de Where Winds Meet (36 teclas)",
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=22.12"
    },
    "scripts": {
        "start": "npm run tauri:run",
        "dev": "npm run tauri:run",
        "build": "npm run build:ui",
        "build:ui": "npm run typecheck && vite build",
        "typecheck": "tsc -p tsconfig.renderer.json",
        "tauri:ui": "npm run build:ui",
        "tauri:check": "node tools/run-cargo.cjs check --manifest-path src-tauri/Cargo.toml",
        "tauri:run": "npm run build:ui && node tools/run-cargo.cjs run --manifest-path src-tauri/Cargo.toml",
        "tauri:build": "node tools/run-tauri.cjs build --bundles nsis",
        "dist": "npm run tauri:build",
        "format": "biome format --write .",
        "format:check": "biome check .",
        "lint": "biome lint .",
        "check": "biome check .",
        "test:renderer": "vitest run",
        "test:rust": "node tools/run-cargo.cjs test --manifest-path src-tauri/Cargo.toml",
        "test": "npm run check && npm run typecheck && npm run test:renderer && npm run test:rust",
        "test:desktop": "npm run build:ui && node tools/smoke-tauri.cjs"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@tailwindcss/vite": "4.3.3",
        "@tauri-apps/cli": "^2.12.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "jsdom": "29.1.1",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "^5.6.3",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    },
    "dependencies": {
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "lucide-react": "1.62.0",
        "radix-ui": "1.8.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "sonner": "2.0.8",
        "tailwind-merge": "3.7.0"
    }
}
