{
  "name": "wwm-player",
  "version": "1.0.0",
  "description": "Toca MIDI no modo de música livre de Where Winds Meet (36 teclas)",
  "main": "dist/player.js",
  "scripts": {
    "start": "tsx src/player.ts",
    "dev": "nodemon --watch src --ext ts --exec tsx src/player.ts",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "koffi": "^3.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14"
  }
}
