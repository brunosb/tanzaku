{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "noEmit": true,
        "jsx": "react-jsx",
        "allowImportingTsExtensions": true,
        "baseUrl": ".",
        "paths": { "@/*": ["src/renderer/*"] },
        "strict": true,
        "skipLibCheck": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client"]
    },
    "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"]
}
